# APP_URL: The URL where this application is hosted (e.g. Vercel deployment URL).
APP_URL="https://your-jitalx-domain.vercel.app"

# =============================================================================
# STRIPE INTEGRATION (PREPARED — DO NOT COMMIT LIVE SECRET KEYS)
# =============================================================================
# Public Stripe publishable key (pk_test_... or pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=""

# Stripe Price IDs for JITALX subscription plans (configure in Stripe Dashboard)
VITE_STRIPE_PRICE_PRO_MONTHLY=""
VITE_STRIPE_PRICE_LIFETIME=""
VITE_STRIPE_PRICE_CREATOR_MONTHLY=""

# Optional Stripe Customer Billing Portal URL & Checkout API Endpoint
VITE_STRIPE_PORTAL_URL=""
VITE_STRIPE_CHECKOUT_ENDPOINT="/api/stripe/create-checkout-session"

# Server-side only (Vercel Environment Variables — never prefix with VITE_)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Contact email for Creator Partnerships & Press inquiries
VITE_CONTACT_EMAIL="contact@10jital.com"
