# =============================================================================
# JITALX — 10JITAL PROD · ENVIRONMENT CONFIGURATION TEMPLATE
# Never commit real secret values to source control.
# =============================================================================

# Public application URL (used for OAuth callbacks & Stripe redirects)
APP_URL="https://your-jitalx-domain.example.com"

# =============================================================================
# GUMROAD WEBHOOK (LAUNCH OFFER 7 EUR ONE-TIME) — SERVER-SIDE ONLY
# =============================================================================
GUMROAD_WEBHOOK_TOKEN=""
GUMROAD_SELLER_ID=""
GUMROAD_PRODUCT_ID=""
GUMROAD_PRODUCT_PERMALINK="jitalx-full-access"
GUMROAD_ALLOW_TEST="false"

# =============================================================================
# STRIPE SUBSCRIPTIONS (PRO 4.99 EUR/MO & CREATOR STUDIO 14.99 EUR/MO)
# =============================================================================
# Server-side secrets (NEVER prefix with VITE_)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_CREATOR_MONTHLY=""

# Optional client-side public Stripe identifiers
VITE_STRIPE_PUBLISHABLE_KEY=""
VITE_STRIPE_PORTAL_URL=""
VITE_STRIPE_CHECKOUT_ENDPOINT="/api/stripe/create-checkout-session"

# =============================================================================
# TWITCH & YOUTUBE CREATOR OAUTH (OPTIONAL) — SERVER-SIDE ONLY
# =============================================================================
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Contact email for Creator Partnerships & Press inquiries
VITE_CONTACT_EMAIL="contact@10jital.com"

# Official JITALX Community Discord invite URL
VITE_DISCORD_INVITE_URL="https://discord.gg/rW3z3JQSs"
